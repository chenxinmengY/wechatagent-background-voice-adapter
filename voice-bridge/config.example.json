{
  "enabled": true,
  "wechatagentRoot": "",
  "chats": {},
  "policy": {
    "mode": "trigger",
    "triggerWords": [
      "想听你说",
      "说一句"
    ],
    "probability": 0.9,
    "minChars": 2,
    "maxChars": 60,
    "minIntervalSeconds": 8,
    "freshSeconds": 180,
    "skipIfContains": [
      "http://",
      "https://",
      "```",
      ".zip",
      ".mp4"
    ]
  },
  "tts": {
    "provider": "edge",
    "voice": "zh-CN-XiaoxiaoNeural",
    "rate": "+0%",
    "pitch": "+0Hz",
    "volume": "+0%",
    "python": "python",
    "ffmpeg": "ffmpeg",
    "ffprobe": "ffprobe"
  },
  "send": {
    "testTarget": "filehelper",
    "fileName": "voice-{time}.mp3",
    "bitrate": "64k"
  }
}